# ============================================================================
# Local Print Bridge — environment configuration
#
# Copy this file to `.env` in this directory and fill in real values.
# Never commit a real `.env` file. Never put a Supabase service_role key
# here — see README.md "Security" section for why.
# ============================================================================

# --- Supabase project (same project the main app uses) ---------------------
# Same values as the frontend's VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
# The anon key is safe here: it is the SAME key already shipped in the
# browser bundle. It grants nothing by itself — every RPC the bridge calls
# is still gated by Postgres RLS + the SECURITY DEFINER checks inside
# claim_kot_print_job / mark_kot_print_job_printed / mark_kot_print_job_failed.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Bridge identity ---------------------------------------------------------
# The bridge authenticates as a REAL Supabase Auth user, exactly like a
# member of staff logging into the Reception/Kitchen dashboard would. This
# is intentional (see README "Authentication model"): claim_kot_print_job()
# etc. require auth.uid() to resolve to a profiles row with role
# 'kitchen', 'owner', 'admin', or 'super_admin' for this restaurant.
#
# Create a dedicated staff account for this purpose (e.g. a profile with
# role='kitchen', full_name='Print Bridge') rather than reusing a human
# staff member's login. Do NOT use the service_role key as a shortcut —
# that would bypass every RLS check this project relies on.
BRIDGE_AUTH_EMAIL=
BRIDGE_AUTH_PASSWORD=

# The restaurant this bridge instance serves. One bridge process currently
# serves exactly one restaurant (see README "Scope boundary").
RESTAURANT_ID=

# --- Queue behavior ----------------------------------------------------------
# How often (ms) the bridge reconciles the queue by polling, in addition to
# reacting to Realtime notifications. Realtime wakes the worker quickly;
# this poll is the reliability backstop for missed/late Realtime events.
POLL_INTERVAL_MS=15000

# --- Printer ------------------------------------------------------------------
# true  -> use the built-in DevelopmentPrinterAdapter (no physical printer
#          required; NEVER marks a job as printed — see README "Test mode").
# false -> use the real ESC/POS-over-TCP adapter. The printer's IP/port/
#          brand/model come from the active row in `printer_settings` for
#          RESTAURANT_ID (configured by the restaurant admin in
#          Settings → Kitchen Printer) — NOT from this file. If there is no
#          active LAN/Wi-Fi printer configured, or it's set to `usb`
#          (not yet implemented), the bridge exits on startup with a clear
#          error rather than silently falling back to mock mode.
#          See PHYSICAL_PRINTER.md.
MOCK_PRINTER=true

# --- Local health endpoint ------------------------------------------------
# Bound to 127.0.0.1 only, by design (see README "Security"). Not reachable
# from other machines on the network.
HEALTH_PORT=4788

# --- Logging ------------------------------------------------------------------
# One of: debug, info, warn, error
LOG_LEVEL=info
