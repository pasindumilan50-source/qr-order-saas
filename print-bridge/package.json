{
  "name": "qr-order-print-bridge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local Print Bridge: Supabase KOT print queue -> local KOT printer. Runs as an independent process on the restaurant's local computer, separate from the browser frontend.",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "start:no-env-file": "node src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint . --ext js --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  }
}
